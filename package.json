{
  "name": "godot-vocabulary",
  "version": "1.3.4",
  "private": true,
  "description": "Offline PWA that drills Godot 4.7 API, GDScript and Git/GitHub vocabulary as four-choice FSRS cards.",
  "license": "MIT",
  "author": "Tyler Alex (talex444)",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-lessons.mjs && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vite build && playwright test --pass-with-no-tests",
    "generate": "node scripts/generate.mjs",
    "fetch-sources": "node scripts/fetch-sources.mjs",
    "lint:css": "node scripts/lint-css.mjs && node scripts/lint-dom.mjs",
    "lint:lessons": "node scripts/check-lessons.mjs",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "android:debug": "node scripts/gradle.mjs assembleDebug",
    "android:build": "node scripts/gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "idb": "^8.0.4",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.11.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
